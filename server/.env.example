# Copy to .env and adjust. .env is gitignored.
NODE_ENV=development
PORT=4000

# SQLite database file (created automatically).
DB_PATH=./data/app.db

# Comma-separated list of allowed browser origins (the static site).
CORS_ORIGINS=http://localhost:8765,http://127.0.0.1:8765

# Session cookie.
COOKIE_NAME=sid
COOKIE_SECURE=false          # set true in production (HTTPS only)
SESSION_TTL_HOURS=168        # 7 days

# bcrypt cost factor.
BCRYPT_ROUNDS=12

# Seed admin (created on first migrate if no admin exists).
# If ADMIN_PASSWORD is omitted a random one is generated and printed once.
ADMIN_EMAIL=admin@local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe!2026

# Base URL of the static site, used to build verification / reset links.
APP_BASE_URL=http://localhost:8765

# One-time token lifetimes + resend throttling.
VERIFY_TTL_HOURS=24
RESET_TTL_MIN=30
RESEND_COOLDOWN_SEC=60

# Email delivery. Leave SMTP_HOST empty to use the dev transport (logs +
# data/outbox + devLink in responses). Set these to send real email.
MAIL_FROM=Crypto AI <no-reply@cryptoai.local>
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
