# Ignore data files — but DO track the prediction journals, so the durable
# per-cycle record (data/predictions_*.jsonl) is backed up off-machine in git,
# not just on this laptop. Must be data/* (not data/) or the negation below
# can't re-include a file whose parent dir is excluded.
data/*
!data/predictions_*.jsonl
processed_data/
models/
models_v2/

# Ignore python cache
__pycache__/
*.pyc

# Ignore engine run logs and backups
logs/
*.log
*.bak

# Ignore virtual environment
.venv/
.venv312/
.venv_old313/
venv/

# Ignore large specific files
*.csv
*.pkl
*.npy
*.keras

# Secrets — never commit real credentials.
# The *.example.json templates and the README ARE tracked (placeholders only).
secrets/*
!secrets/README.md
!secrets/*.example.json
# (legacy locations, in case any are left at the root)
supabase_creds.json
credentials.json
token.json

#Ignor plans and reports
audit_report.md
model_audit.md

# University submission deliverables — generated bundle + its zip, kept out of git
docs/submission/
docs/submission.zip
.DS_Store
**/.DS_Store

.claude/

make_admin.json
