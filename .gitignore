# Ignore data files
data/
processed_data/
models/
models_v2/

# Ignore python cache
__pycache__/
*.pyc

# Ignore engine run logs and backups
logs/
*.log
*.bak

# Ignore virtual environment
.venv/
.venv312/
.venv_old313/
venv/

# Ignore large specific files
*.csv
*.pkl
*.npy
*.keras

# Secrets — never commit real credentials.
# The *.example.json templates and the README ARE tracked (placeholders only).
secrets/*
!secrets/README.md
!secrets/*.example.json
# (legacy locations, in case any are left at the root)
supabase_creds.json
credentials.json
token.json

#Ignor plans and reports
audit_report.md
model_audit.md
.DS_Store
**/.DS_Store

.claude/
